# Contributor: yzfly <zphyix@gmail.com>
# Maintainer: yzfly <zphyix@gmail.com>
#
# For aports (testing/qsh). On a version bump: pkgver, then `abuild checksum`.
# The cargo feature self-install (downloads release binaries at runtime) is off by default and
# stays off.
pkgname=qsh
pkgver=0.2.0
pkgrel=0
pkgdesc="Remote shell over QUIC whose sessions survive network changes"
url="https://github.com/yzfly/qsh"
# ring (via rustls and quinn) builds on every architecture Alpine has rust on
arch="all"
license="MIT OR Apache-2.0"
depends="openssh-client"
makedepends="cargo cargo-auditable"
# The end-to-end tests look at processes with ps -o (busybox ps lacks the fields)
checkdepends="procps-ng"
subpackages="
	$pkgname-doc
	$pkgname-server
	$pkgname-server-openrc:server_openrc:noarch
	$pkgname-bash-completion
	$pkgname-zsh-completion
	$pkgname-fish-completion
	"
source="$pkgname-$pkgver.tar.gz::https://github.com/yzfly/qsh/archive/v$pkgver/qsh-$pkgver.tar.gz"
options="net" # cargo fetch

prepare() {
	default_prepare

	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo auditable build --frozen --release --package qsh-cli --bins
}

check() {
	cargo test --frozen --package qsh-core --package qsh-cli
}

package() {
	install -Dm755 target/release/qsh target/release/qsh-server -t "$pkgdir"/usr/bin/

	install -Dm644 man/qsh.1 man/qsh-server.1 -t "$pkgdir"/usr/share/man/man1/
	install -Dm644 man/qsh_config.5 -t "$pkgdir"/usr/share/man/man5/

	install -Dm644 completions/qsh.bash "$pkgdir"/usr/share/bash-completion/completions/qsh
	install -Dm644 completions/qsh-server.bash "$pkgdir"/usr/share/bash-completion/completions/qsh-server
	install -Dm644 completions/_qsh completions/_qsh-server -t "$pkgdir"/usr/share/zsh/site-functions/
	install -Dm644 completions/qsh.fish completions/qsh-server.fish \
		-t "$pkgdir"/usr/share/fish/vendor_completions.d/

	install -Dm755 packaging/openrc/qsh-server "$pkgdir"/etc/init.d/qsh-server
	install -Dm644 packaging/firewalld/qsh.xml "$pkgdir"/usr/lib/firewalld/services/qsh.xml
	install -Dm644 packaging/ufw/qsh "$pkgdir"/etc/ufw/applications.d/qsh

	install -Dm644 README.md docs/DESIGN.md docs/protocol.md docs/security.md \
		-t "$pkgdir"/usr/share/doc/$pkgname/
	install -Dm644 LICENSE-MIT LICENSE-APACHE -t "$pkgdir"/usr/share/licenses/$pkgname/
}

server() {
	pkgdesc="$pkgdesc (server)"
	depends=""

	amove usr/bin/qsh-server
	amove usr/lib/firewalld
	amove etc/ufw
}

server_openrc() {
	pkgdesc="$pkgdesc (server OpenRC script)"
	install_if="openrc $pkgname-server=$pkgver-r$pkgrel"
	depends=""

	amove etc/init.d/qsh-server
}

sha512sums="
373cca21814f5e26aaad9fab02ae1b30ead4e107eee6d1c7f8e201ce54a0f615804eefeb78748c86f7211e0ad597fdad918d2f6af3ea9411f6aa2742de87b78a  qsh-0.2.0.tar.gz
"
