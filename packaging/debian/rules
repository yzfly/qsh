#!/usr/bin/make -f
# Debian build of qsh, a cargo workspace with two binaries (qsh, qsh-server) in the crate
# qsh-cli. The usual route for Rust applications in Debian: dependencies come from the archive's
# librust-*-dev packages through dh-cargo's cargo wrapper, built offline.
#
# Build profile pkg.qsh.vendored: build with the crates in vendor/ instead (`cargo vendor --locked`,
# shipped as the orig component tarball qsh_VERSION.orig-vendor.tar.xz). For backports, for
# derivatives whose archive lacks some librust-*-dev versions, and for upstream's CI:
#   DEB_BUILD_PROFILES=pkg.qsh.vendored dpkg-buildpackage -us -uc
#
# The cargo feature self-install (downloads release binaries at runtime) is off by default and
# stays off here: Debian's qsh never fetches code from the network.

include /usr/share/dpkg/pkg-info.mk
include /usr/share/dpkg/architecture.mk
include /usr/share/dpkg/buildopts.mk
# From the rustc package; a vendored build with a rustup toolchain (backports to releases whose
# rustc is older than rust-version) has to work it out itself, for native builds only.
ifneq (,$(wildcard /usr/share/rustc/architecture.mk))
include /usr/share/rustc/architecture.mk
endif
DEB_HOST_RUST_TYPE ?= $(shell rustc -vV | sed -n 's/^host: //p')

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
include /usr/share/dpkg/buildflags.mk
export CARGO_HOME = $(CURDIR)/debian/cargo_home
export DEB_CARGO_CRATE = qsh-cli_$(DEB_VERSION_UPSTREAM)

# The programs and the library they are built from; xtask (the man page generator) is not built.
CARGO_PACKAGES = --package qsh-core --package qsh-cli

ifneq (,$(filter pkg.qsh.vendored,$(DEB_BUILD_PROFILES)))
# Plain cargo against vendor/, with the flags dh-cargo's wrapper would add.
CARGO = cargo
CARGO_FLAGS = --release --frozen --target $(DEB_HOST_RUST_TYPE) \
	$(addprefix -j,$(DEB_BUILD_OPTION_PARALLEL))
# Debug info for the -dbgsym packages (dh_strip strips the programs), dpkg-buildflags' LDFLAGS
# (relro, now) for the linker.
export CARGO_PROFILE_RELEASE_STRIP = false
export CARGO_PROFILE_RELEASE_DEBUG = 2
export RUSTFLAGS = --cap-lints warn -C linker=$(DEB_HOST_GNU_TYPE)-gcc \
	$(foreach f,$(shell dpkg-buildflags --get LDFLAGS),-C link-arg=$(f))
else
# dh-cargo's wrapper (/usr/share/cargo/bin/cargo, from the cargo package): adds --target and -j,
# and its prepare-debian writes the rustflags (debug info, LDFLAGS as link args) and points
# crates-io at the archive's crates. It needs these in the environment, as dh-cargo's own
# buildsystem would set them.
CARGO = /usr/share/cargo/bin/cargo
CARGO_FLAGS = --release
export CFLAGS CXXFLAGS CPPFLAGS LDFLAGS
export DEB_HOST_RUST_TYPE DEB_HOST_GNU_TYPE
endif

CARGO_TARGET_OUT = target/$(DEB_HOST_RUST_TYPE)/release

%:
	dh $@

override_dh_auto_configure:
ifneq (,$(filter pkg.qsh.vendored,$(DEB_BUILD_PROFILES)))
	mkdir -p $(CARGO_HOME)
	printf '%s\n' \
		'[source.crates-io]' 'replace-with = "vendored-sources"' \
		'[source.vendored-sources]' 'directory = "$(CURDIR)/vendor"' \
		'[net]' 'offline = true' > $(CARGO_HOME)/config.toml
else
	# Like dh-cargo: Cargo.lock pins crates.io versions, the archive has its own; cargo resolves
	# against debian/cargo_registry instead. Kept aside so that clean restores the source.
	if [ -e Cargo.lock ] && [ ! -e debian/Cargo.lock.upstream ]; then mv Cargo.lock debian/Cargo.lock.upstream; fi
	$(CARGO) prepare-debian $(CURDIR)/debian/cargo_registry --link-from-system
endif

override_dh_auto_build:
	$(CARGO) build $(CARGO_FLAGS) $(CARGO_PACKAGES) --bins

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	$(CARGO) test $(CARGO_FLAGS) $(CARGO_PACKAGES)
endif

# dh_install, dh_installman and dh_bash-completion take it from here (debian/qsh-*.install, ...).
override_dh_auto_install:
	install -d debian/tmp/usr/bin
	install -m 0755 $(CARGO_TARGET_OUT)/qsh $(CARGO_TARGET_OUT)/qsh-server debian/tmp/usr/bin/

override_dh_installsystemduser:
	# The user unit is shipped but not enabled: qsh-server starts on demand over ssh.
	dh_installsystemduser --no-enable

override_dh_gencontrol:
ifeq (,$(filter pkg.qsh.vendored,$(DEB_BUILD_PROFILES)))
	/usr/share/cargo/bin/dh-cargo-built-using qsh-client
	/usr/share/cargo/bin/dh-cargo-built-using qsh-server
	dh_gencontrol
else
	# Built from vendor/, not from other packages' sources: no Built-Using.
	dh_gencontrol -- -Vcargo:Built-Using= -Vcargo:Static-Built-Using= -Vcargo:X-Cargo-Built-Using=
endif

override_dh_auto_clean:
	rm -rf target debian/cargo_home debian/cargo_registry
	if [ -e debian/Cargo.lock.upstream ]; then mv -f debian/Cargo.lock.upstream Cargo.lock; fi

# dh_clean deletes *.orig files, and cargo checks vendor/*/Cargo.toml.orig against
# .cargo-checksum.json.
override_dh_clean:
	dh_clean -XCargo.toml.orig
