#compdef qsh-server

autoload -U is-at-least

_qsh-server() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'*-v[Log more (repeat for more)]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_qsh-server_commands" \
"*::: :->qsh-server" \
&& ret=0
    case $state in
    (qsh-server)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:qsh-server-command-$line[1]:"
        case $line[1] in
            (bootstrap)
_arguments "${_arguments_options[@]}" : \
'*-v[Log more (repeat for more)]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(pipe)
_arguments "${_arguments_options[@]}" : \
'--version=[Protocol version]:N:_default' \
'*-v[Log more (repeat for more)]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(daemon)
_arguments "${_arguments_options[@]}" : \
'--ports=[Ports to try, FIRST-LAST; the first free on both UDP and TCP is used]:FIRST-LAST:_default' \
'--foreground[Stay in the foreground (for service managers); otherwise start in the background]' \
'--on-demand[Exit after an hour without sessions (set when started on demand)]' \
'*-v[Log more (repeat for more)]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
'*-v[Log more (repeat for more)]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(stop)
_arguments "${_arguments_options[@]}" : \
'*-v[Log more (repeat for more)]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(upgrade)
_arguments "${_arguments_options[@]}" : \
'--exe=[The qsh-server to run (default\: this program)]:PATH:_files' \
'--force[Upgrade even to a version that is not newer]' \
'*-v[Log more (repeat for more)]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(doctor)
_arguments "${_arguments_options[@]}" : \
'--ports=[The ports to check and open, FIRST-LAST (default\: the configured range)]:FIRST-LAST:_default' \
'--root=[Tests only\: read /etc, /proc, /sys and /var under DIR instead of /, without following symbolic links; no command of the host runs (see --commands)]:DIR:_files' \
'--commands=[Tests only, with --root\: the stub programs that stand in for the host'\''s commands]:DIR:_files' \
'--json[Print JSON (schema version 1, stable check ids; see qsh-server(1))]' \
'--probe[Start the daemon if it does not run, and report its ports and certificate (what qsh doctor HOST runs)]' \
'*-v[Log more (repeat for more)]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(tune)
_arguments "${_arguments_options[@]}" : \
'--allow-low-ports=[Let every user bind ports from PORT up (ip_unprivileged_port_start; single-user hosts only)]:PORT:_default' \
'--ports=[The ports to open, FIRST-LAST (default\: the configured range and extra ports)]:FIRST-LAST:_default' \
'--root=[Tests only\: read and change /etc, /proc/sys and /var under DIR instead of /, without following symbolic links; no command of the host runs (see --commands)]:DIR:_files' \
'--commands=[Tests only, with --root\: the stub programs that stand in for the host'\''s commands]:DIR:_files' \
'(--revert)--apply[Make the changes (root; asks first)]' \
'--revert[Undo what tune changed, as recorded in /var/lib/qsh/tune.json (root; asks first)]' \
'-y[Do not ask (scripts)]' \
'--yes[Do not ask (scripts)]' \
'--bbr-default[Also make BBR with fq the default for every TCP connection of the host (sshd'\''s too)]' \
'--linger[Enable linger for the user who ran sudo even where logind keeps processes at logout]' \
'*-v[Log more (repeat for more)]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(handoff-probe)
_arguments "${_arguments_options[@]}" : \
'*-v[Log more (repeat for more)]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_qsh-server__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:qsh-server-help-command-$line[1]:"
        case $line[1] in
            (bootstrap)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(pipe)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(daemon)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(stop)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(upgrade)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(doctor)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(tune)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(handoff-probe)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_qsh-server_commands] )) ||
_qsh-server_commands() {
    local commands; commands=(
'bootstrap:Create a session for the client (run over ssh; request on stdin, reply on stdout)' \
'pipe:Carry a connection over ssh'\''s stdin and stdout (run over ssh by the client)' \
'daemon:Run the per-user daemon (started on demand by bootstrap otherwise)' \
'status:Show the running daemon and its sessions (JSON)' \
'stop:Stop the running daemon; its sessions end' \
'upgrade:Replace the running daemon with a newer qsh-server in place; sessions are kept' \
'doctor:Check this host for everything that slows qsh down or stops a transport' \
'tune:Show, apply (root) or revert the host settings that make qsh faster' \
'handoff-probe:Print the version and the handoff state formats this program reads (used by upgrades)' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'qsh-server commands' commands "$@"
}
