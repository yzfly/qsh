#compdef qsh-server

autoload -U is-at-least

_qsh-server() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'*-v[Log more (repeat for more)]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_qsh-server_commands" \
"*::: :->qsh-server" \
&& ret=0
    case $state in
    (qsh-server)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:qsh-server-command-$line[1]:"
        case $line[1] in
            (bootstrap)
_arguments "${_arguments_options[@]}" : \
'*-v[Log more (repeat for more)]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(pipe)
_arguments "${_arguments_options[@]}" : \
'--version=[Protocol version]:N:_default' \
'*-v[Log more (repeat for more)]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(daemon)
_arguments "${_arguments_options[@]}" : \
'--ports=[Ports to try, FIRST-LAST; the first free on both UDP and TCP is used]:FIRST-LAST:_default' \
'--state-fd=[The descriptor of the sealed state (with --resume)]:FD:_default' \
'--key-fd=[The descriptor of the pipe with the state'\''s key (with --resume)]:FD:_default' \
'--fallback-exe-fd=[The descriptor of the previous program, run again if resuming fails (with --resume)]:FD:_default' \
'--foreground[Stay in the foreground (for service managers); otherwise start in the background]' \
'--on-demand[Exit after an hour without sessions (set when started on demand)]' \
'--resume[Resume from the state an older image of this daemon handed over (an upgrade in place)]' \
'--fell-back[The new program could not resume; this is the previous one again (with --resume)]' \
'*-v[Log more (repeat for more)]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
'*-v[Log more (repeat for more)]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(stop)
_arguments "${_arguments_options[@]}" : \
'*-v[Log more (repeat for more)]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(upgrade)
_arguments "${_arguments_options[@]}" : \
'--exe=[The qsh-server to run (default\: this program)]:PATH:_files' \
'--force[Upgrade even to a version that is not newer]' \
'*-v[Log more (repeat for more)]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(handoff-probe)
_arguments "${_arguments_options[@]}" : \
'*-v[Log more (repeat for more)]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_qsh-server__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:qsh-server-help-command-$line[1]:"
        case $line[1] in
            (bootstrap)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(pipe)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(daemon)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(stop)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(upgrade)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(handoff-probe)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_qsh-server_commands] )) ||
_qsh-server_commands() {
    local commands; commands=(
'bootstrap:Create a session for the client (run over ssh; request on stdin, reply on stdout)' \
'pipe:Carry a connection over ssh'\''s stdin and stdout (run over ssh by the client)' \
'daemon:Run the per-user daemon (started on demand by bootstrap otherwise)' \
'status:Show the running daemon and its sessions (JSON)' \
'stop:Stop the running daemon; its sessions end' \
'upgrade:Replace the running daemon with a newer qsh-server in place; sessions are kept' \
'handoff-probe:Print the version and the handoff state formats this program reads (used by upgrades)' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'qsh-server commands' commands "$@"
}
