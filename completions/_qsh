#compdef qsh

autoload -U is-at-least

_qsh() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-p+[Port of the ssh server (ssh -p)]:PORT:_default' \
'-l+[User to log in as (ssh -l)]:USER:_default' \
'*-i+[Identity file (ssh -i); may be repeated]:FILE:_files' \
'-J+[Jump hosts (ssh -J)]:DESTINATION:_default' \
'-F+[ssh configuration file (ssh -F)]:FILE:_files' \
'*-o+[ssh option (ssh -o); may be repeated]:OPTION:_default' \
'-4[Use IPv4 addresses only (ssh -4)]' \
'-6[Use IPv6 addresses only (ssh -6)]' \
'*-v[Verbose\: qsh'\''s own messages, and ssh -v; may be repeated]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
':destination -- `\[user@\]host`, or a host alias from ~/.ssh/config:_default' \
'::command -- Command to run instead of a login shell:_default' \
":: :_qsh_commands" \
"*::: :->qsh" \
&& ret=0
    case $state in
    (qsh)
        words=($line[3] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:qsh-command-$line[3]:"
        case $line[3] in
            (attach)
_arguments "${_arguments_options[@]}" : \
'-p+[Port of the ssh server (ssh -p)]:PORT:_default' \
'-l+[User to log in as (ssh -l)]:USER:_default' \
'*-i+[Identity file (ssh -i); may be repeated]:FILE:_files' \
'-J+[Jump hosts (ssh -J)]:DESTINATION:_default' \
'-F+[ssh configuration file (ssh -F)]:FILE:_files' \
'*-o+[ssh option (ssh -o); may be repeated]:OPTION:_default' \
'-4[Use IPv4 addresses only (ssh -4)]' \
'-6[Use IPv6 addresses only (ssh -6)]' \
'*-v[Verbose\: qsh'\''s own messages, and ssh -v; may be repeated]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':destination -- `\[user@\]host` the session runs on:_default' \
'::session -- Session id (or a unique prefix of it) or name, as `qsh ls` shows them:_default' \
&& ret=0
;;
(ls)
_arguments "${_arguments_options[@]}" : \
'-p+[Port of the ssh server (ssh -p)]:PORT:_default' \
'-l+[User to log in as (ssh -l)]:USER:_default' \
'*-i+[Identity file (ssh -i); may be repeated]:FILE:_files' \
'-J+[Jump hosts (ssh -J)]:DESTINATION:_default' \
'-F+[ssh configuration file (ssh -F)]:FILE:_files' \
'*-o+[ssh option (ssh -o); may be repeated]:OPTION:_default' \
'--json[Print JSON, for scripts]' \
'-4[Use IPv4 addresses only (ssh -4)]' \
'-6[Use IPv6 addresses only (ssh -6)]' \
'*-v[Verbose\: qsh'\''s own messages, and ssh -v; may be repeated]' \
'-h[Print help]' \
'--help[Print help]' \
'::destination -- `\[user@\]host` to ask; without it, the sessions saved on this machine (no network):_default' \
&& ret=0
;;
(kill)
_arguments "${_arguments_options[@]}" : \
'-p+[Port of the ssh server (ssh -p)]:PORT:_default' \
'-l+[User to log in as (ssh -l)]:USER:_default' \
'*-i+[Identity file (ssh -i); may be repeated]:FILE:_files' \
'-J+[Jump hosts (ssh -J)]:DESTINATION:_default' \
'-F+[ssh configuration file (ssh -F)]:FILE:_files' \
'*-o+[ssh option (ssh -o); may be repeated]:OPTION:_default' \
'--all[End every session on DESTINATION]' \
'-4[Use IPv4 addresses only (ssh -4)]' \
'-6[Use IPv6 addresses only (ssh -6)]' \
'*-v[Verbose\: qsh'\''s own messages, and ssh -v; may be repeated]' \
'-h[Print help]' \
'--help[Print help]' \
':destination -- `\[user@\]host` the session runs on:_default' \
'::session -- Session id (or a unique prefix of it) or name, as `qsh ls` shows them:_default' \
&& ret=0
;;
(install)
_arguments "${_arguments_options[@]}" : \
'--from=[Copy this qsh-server binary instead (built for the host'\''s system)]:FILE:_files' \
'-p+[Port of the ssh server (ssh -p)]:PORT:_default' \
'-l+[User to log in as (ssh -l)]:USER:_default' \
'*-i+[Identity file (ssh -i); may be repeated]:FILE:_files' \
'-J+[Jump hosts (ssh -J)]:DESTINATION:_default' \
'-F+[ssh configuration file (ssh -F)]:FILE:_files' \
'*-o+[ssh option (ssh -o); may be repeated]:OPTION:_default' \
'-4[Use IPv4 addresses only (ssh -4)]' \
'-6[Use IPv6 addresses only (ssh -6)]' \
'*-v[Verbose\: qsh'\''s own messages, and ssh -v; may be repeated]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':destination -- `\[user@\]host` to install on:_default' \
&& ret=0
;;
        esac
    ;;
esac
}

(( $+functions[_qsh_commands] )) ||
_qsh_commands() {
    local commands; commands=(
'attach:Reattach a detached session, replaying the output it produced meanwhile' \
'ls:List sessions\: on DESTINATION (over ssh), or the saved ones of every host' \
'kill:End a session\: its programs get SIGHUP' \
'install:Install qsh-server into ~/.local/bin on DESTINATION (builds with feature self-install)' \
    )
    _describe -t commands 'qsh commands' commands "$@"
}
(( $+functions[_qsh__subcmd__attach_commands] )) ||
_qsh__subcmd__attach_commands() {
    local commands; commands=()
    _describe -t commands 'qsh attach commands' commands "$@"
}
(( $+functions[_qsh__subcmd__install_commands] )) ||
_qsh__subcmd__install_commands() {
    local commands; commands=()
    _describe -t commands 'qsh install commands' commands "$@"
}
(( $+functions[_qsh__subcmd__kill_commands] )) ||
_qsh__subcmd__kill_commands() {
    local commands; commands=()
    _describe -t commands 'qsh kill commands' commands "$@"
}
(( $+functions[_qsh__subcmd__ls_commands] )) ||
_qsh__subcmd__ls_commands() {
    local commands; commands=()
    _describe -t commands 'qsh ls commands' commands "$@"
}

if [ "$funcstack[1]" = "_qsh" ]; then
    _qsh "$@"
else
    compdef _qsh qsh
fi
